{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "#*": [
        "./src/*"
      ]
    },
    "module": "ESNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "ESNext",
    "moduleResolution": "node",
    "sourceMap": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/typings"
    ],
    "plugins": [
      {
        "transform": "transformer-module"
      }
    ],
    "skipLibCheck": true
  },
  "lib": [
    "es2015"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "test.ts"
  ]
}