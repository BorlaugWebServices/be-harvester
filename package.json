{
  "name": "be-harvester",
  "version": "1.0.0",
  "description": "Listen to blocks and transactions and writes to be-datastore",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "npm run build && cross-env DEBUG=be-harvester:* npm run start",
    "start": "node --enable-source-maps dist/index.js",
    "migration": "tsc && node dist/migration/up.js",
    "rollback": "tsc && node dist/migration/down.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com/BorlaugWebServices/be-harvester.git"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@polkadot/typegen": "^15.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@polkadot/api": "^15.0.1",
    "@types/debug": "^4.1.12",
    "be-datastore": "github:BorlaugWebServices/be-datastore#sandbox",
    "debug": "^4.4.0",
    "dotenv": "^16.4.5",
    "jayson": "^4.1.2",
    "lodash": "^4.17.21"
  },
  "imports": {
    "#*": "./dist/*.js"
  }
}
